# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/fivebot"

# Redis Configuration
REDIS_URL="redis://:password@localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Encryption Configuration
ENCRYPTION_KEY="base64:your-256bit-encryption-key-change-this"

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID="your-discord-application-client-id"
DISCORD_CLIENT_SECRET="your-discord-application-client-secret"
DISCORD_CALLBACK_URL="http://localhost:3000/auth/discord/callback"

# Main Bot Configuration (Manager Bot)
DISCORD_BOT_TOKEN="your-main-bot-token"
DISCORD_GUILD_ID="your-test-guild-id"

# Worker Configuration
WORKER_CONCURRENCY=5
MAX_BOTS_PER_USER=5

# Storage Configuration (Optional - for logo uploads)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="fivebot-assets"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"

# Application Configuration
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
NODE_ENV="development"

# Docker Configuration
DOCKER_SOCKET="/var/run/docker.sock"
BOT_IMAGE_NAME="fivebot/child-bot"
BOT_NETWORK="fivebot_network"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Credit System
DEFAULT_CREDITS=100
CREDIT_PER_BOT=10