# FiveBot Docker Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
POSTGRES_PASSWORD=your-secure-postgres-password

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development

# ===========================================
# SECURITY
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# Generate encryption key: openssl rand -base64 32

# ===========================================
# DISCORD OAUTH
# ===========================================
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_CALLBACK_URL=http://localhost:8000/auth/discord/callback

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# ===========================================
# BOT MANAGER (optional)
# ===========================================
# Only needed if running with bot-manager profile
# docker-compose --profile with-bot-manager up
BOT_MANAGER_TOKEN=your-main-bot-token
