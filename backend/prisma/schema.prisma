  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([botId])
  @@map("anti_nuke_configs")
}

model AntiNukeLog {
  id         String   @id @default(uuid())
  guildId    String   @map("guild_id")
  botId      String   @map("bot_id")
  actionType String   @map("action_type") // CHANNEL_CREATE, ROLE_DELETE, MASS_BAN, etc.
  userId     String   @map("user_id")
  targetId   String?  @map("target_id")
  targetType String?  @map("target_type")
  punishment String?
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([guildId])
  @@index([userId])
  @@map("anti_nuke_logs")
}

// ==================== CUSTOM COMMANDS SYSTEM ====================

model CustomCommandConfig {
  id      String  @id @default(uuid())
  guildId String  @unique @map("guild_id")
  botId   String  @map("bot_id")
  enabled Boolean @default(true)

  maxCommands      Int @default(50) @map("max_commands")
  allowedCreateRoles String? @map("allowed_create_roles") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commands CustomCommand[]

  @@index([botId])
  @@map("custom_command_configs")
}

model CustomCommand {
  id       String @id @default(uuid())
  configId String @map("config_id")
  name     String
  description String?
  enabled  Boolean @default(true)

  // Trigger
  trigger     String // Command name or regex
  triggerType String @default("COMMAND") @map("trigger_type") // COMMAND, STARTSWITH, CONTAINS, REGEX
  caseSensitive Boolean @default(false) @map("case_sensitive")

  // Response
  responseType String @default("TEXT") @map("response_type") // TEXT, EMBED, RANDOM, SEQUENCE
  responses    String @db.Text // JSON array of responses

  // Actions (JSON array)
  actions String? @db.Text // ADD_ROLE, REMOVE_ROLE, SEND_DM, REACT, DELETE_TRIGGER

  // Restrictions
  allowedRoles    String? @map("allowed_roles") @db.Text
  allowedChannels String? @map("allowed_channels") @db.Text
  blockedRoles    String? @map("blocked_roles") @db.Text
  blockedChannels String? @map("blocked_channels") @db.Text
  nsfw            Boolean @default(false)

  // Cooldowns
  userCooldown   Int @default(0) @map("user_cooldown")
  guildCooldown  Int @default(0) @map("guild_cooldown")

  // Stats
  uses      Int @default(0)
  createdBy String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  config CustomCommandConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, name])
  @@index([configId])
  @@map("custom_commands")
}

// ==================== SERVER STATS ====================

model ServerStatsConfig {
  id             String               @id @default(uuid())
  guildId        String               @unique @map("guild_id")
  botId          String               @map("bot_id")
  enabled        Boolean              @default(true)
  updateInterval Int                  @default(10) @map("update_interval")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  counters       ServerStatsCounter[]

  @@index([botId])
  @@map("server_stats_configs")
}

model ServerStatsCounter {
  id          String            @id @default(uuid())
  configId    String            @map("config_id")
  channelId   String            @map("channel_id")
  guildId     String            @map("guild_id")
  counterType String            @map("counter_type")
  template    String            @default("Members: {count}")
  customValue Int?              @map("custom_value")
  targetRoleId String?          @map("target_role_id")
  channelTypes String?          @map("channel_types") @db.Text
  lastValue   Int               @default(0) @map("last_value")
  lastUpdated DateTime?         @map("last_updated")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  config      ServerStatsConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, channelId])
  @@index([configId])
  @@map("server_stats_counters")
}
