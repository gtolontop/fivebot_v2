generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  discordId      String           @unique @map("discord_id")
  username       String
  email          String?
  avatar         String?
  role           UserRole         @default(USER)
  credits        Int              @default(100)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  auditLogs      AuditLog[]
  bots           Bot[]
  creditsHistory CreditsHistory[]

  @@map("users")
}

model Bot {
  id                String       @id @default(uuid())
  ownerId           String       @map("owner_id")
  name              String
  tokenEncrypted    String       @map("token_encrypted") @db.Text
  clientId          String?      @map("client_id")
  prefix            String       @default("!")
  isActive          Boolean      @default(false) @map("is_active")
  containerId       String?      @map("container_id")
  instanceId        String?      @map("instance_id")
  status            BotStatus    @default(OFFLINE)
  shouldAutoRestart Boolean      @default(true) @map("should_auto_restart")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  auditLogs         AuditLog[]
  config            BotConfig?
  logs              BotLog[]
  metrics           BotMetrics[]
  owner             User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hosts             Host[]
  jobLogs           JobLog[]

  @@index([ownerId], map: "bots_owner_id_fkey")
  @@map("bots")
}

model BotConfig {
  id                  String   @id @default(uuid())
  botId               String   @unique @map("bot_id")
  welcomeEnabled      Boolean  @default(false) @map("welcome_enabled")
  welcomeChannelId    String?  @map("welcome_channel_id")
  welcomeEmbedJson    String?  @map("welcome_embed_json") @db.LongText
  welcomeLogoUrl      String?  @map("welcome_logo_url")
  welcomeThumbnailUrl String?  @map("welcome_thumbnail_url")
  moderationEnabled   Boolean  @default(false) @map("moderation_enabled")
  autoRoleEnabled     Boolean  @default(false) @map("auto_role_enabled")
  autoRoleId          String?  @map("auto_role_id")
  loggingChannelId    String?  @map("logging_channel_id")
  customCommands      String?  @map("custom_commands") @db.LongText
  ticketData          String?  @map("ticket_data") @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  bot                 Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_configs")
}

model CreditsHistory {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  amount    Int
  reason    String
  type      CreditType
  metadata  String?    @db.LongText
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "credits_history_user_id_fkey")
  @@map("credits_history")
}

model Host {
  id          String     @id @default(uuid())
  botId       String     @map("bot_id")
  host        String
  containerId String?    @map("container_id")
  status      HostStatus @default(DOWN)
  cpuLimit    String?    @map("cpu_limit")
  memLimit    String?    @map("mem_limit")
  startedAt   DateTime?  @map("started_at")
  stoppedAt   DateTime?  @map("stopped_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  bot         Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId], map: "hosts_bot_id_fkey")
  @@map("hosts")
}

model JobLog {
  id        String    @id @default(uuid())
  botId     String?   @map("bot_id")
  jobId     String    @map("job_id")
  jobType   String    @map("job_type")
  status    JobStatus
  message   String?   @db.Text
  metadata  String?   @db.LongText
  createdAt DateTime  @default(now()) @map("created_at")
  bot       Bot?      @relation(fields: [botId], references: [id])

  @@index([botId], map: "job_logs_bot_id_fkey")
  @@map("job_logs")
}

model BotLog {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id")
  level     LogLevel @default(INFO)
  message   String   @db.Text
  source    String?
  metadata  String?  @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@map("bot_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  botId     String?  @map("bot_id")
  action    String
  resource  String?
  metadata  String?  @db.LongText
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  bot       Bot?     @relation(fields: [botId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([botId], map: "audit_logs_bot_id_fkey")
  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}

model BotMetrics {
  id                String   @id @default(uuid())
  botId             String   @map("bot_id")
  date              DateTime @map("date") @db.Date
  commandsUsed      Int      @default(0) @map("commands_used")
  messagesProcessed Int      @default(0) @map("messages_processed")
  guildsCount       Int      @default(0) @map("guilds_count")
  usersCount        Int      @default(0) @map("users_count")
  uptimeSeconds     Int      @default(0) @map("uptime_seconds")
  avgResponseTime   Int      @default(0) @map("avg_response_time_ms")
  errorsCount       Int      @default(0) @map("errors_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  bot               Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, date])
  @@map("bot_metrics")
}

model SecurityKey {
  id        String   @id @default(uuid())
  purpose   String   @unique
  keyMeta   String?  @map("key_meta") @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("security_keys")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  SUCCESS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum BotStatus {
  OFFLINE
  STARTING
  ONLINE
  ERROR
  STOPPING
}

enum HostStatus {
  UP
  DOWN
  STARTING
  STOPPING
  ERROR
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CreditType {
  PURCHASE
  BONUS
  SPEND
  REFUND
  ADMIN_ADJUSTMENT
}
