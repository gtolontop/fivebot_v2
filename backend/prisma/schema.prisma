generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(uuid())
  discordId           String            @unique @map("discord_id")
  username            String
  email               String?
  avatar              String?
  role                UserRole          @default(USER)
  credits             Int               @default(100)
  cumulativeUptime    Int               @default(0) @map("cumulative_uptime")
  discordAccessToken  String?           @map("discord_access_token") @db.Text
  discordRefreshToken String?           @map("discord_refresh_token") @db.Text
  discordTokenExpiry  DateTime?         @map("discord_token_expiry")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  auditLogs           AuditLog[]
  bots                Bot[]
  creditsHistory      CreditsHistory[]
  collaborations      BotCollaborator[]
  notifications       Notification[]
  userModules         UserModule[]
  transactions        Transaction[]

  @@map("users")
}

model Bot {
  id             String            @id @default(uuid())
  ownerId        String            @map("owner_id")
  name           String
  tokenEncrypted String            @map("token_encrypted") @db.Text
  clientId       String?           @map("client_id")
  avatar         String?
  banner         String?
  isActive       Boolean           @default(false) @map("is_active")
  containerId    String?           @map("container_id")
  instanceId     String?           @map("instance_id")
  status         BotStatus         @default(OFFLINE)
  startedAt      DateTime?         @map("started_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  auditLogs      AuditLog[]
  config         BotConfig?
  logs           BotLog[]
  metrics        BotMetrics[]
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "bot_owner_fkey")
  hosts          Host[]
  jobLogs        JobLog[]
  commands       BotCommand[]
  collaborators  BotCollaborator[]
  botModules     BotModule[]

  @@index([ownerId], map: "bots_owner_id_fkey")
  @@map("bots")
}

model BotConfig {
  id                        String   @id @default(uuid())
  botId                     String   @unique @map("bot_id")
  welcomeEnabled            Boolean  @default(false) @map("welcome_enabled")
  welcomeChannelId          String?  @map("welcome_channel_id")
  welcomeEmbedJson          String?  @map("welcome_embed_json") @db.Text
  welcomeLogoUrl            String?  @map("welcome_logo_url")
  goodbyeEnabled            Boolean  @default(false) @map("goodbye_enabled")
  goodbyeChannelId          String?  @map("goodbye_channel_id")
  moderationEnabled         Boolean  @default(false) @map("moderation_enabled")
  autoRoleEnabled           Boolean  @default(false) @map("auto_role_enabled")
  autoRoleId                String?  @map("auto_role_id")
  autoRoleIds               String?  @map("auto_role_ids") @db.Text
  loggingChannelId          String?  @map("logging_channel_id")
  customCommands            String?  @map("custom_commands") @db.Text
  ticketEnabled             Boolean  @default(false) @map("ticket_enabled")
  ticketCategoryId          String?  @map("ticket_category_id")
  ticketStaffRoleId         String?  @map("ticket_staff_role_id")
  ticketTranscriptChannelId String?  @map("ticket_transcript_channel_id")
  ticketData                String?  @map("ticket_data") @db.Text
  statusRotation            String?  @map("status_rotation") @db.Text
  embedV2Commands           String?  @map("embed_v2_commands") @db.Text
  embedTemplates            String?  @map("embed_templates") @db.Text
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  bot                       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_configs")
}

model CreditsHistory {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  amount    Int
  reason    String
  type      CreditType
  metadata  String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "credits_history_user_fkey")

  @@index([userId], map: "credits_history_user_id_fkey")
  @@map("credits_history")
}

model Host {
  id          String     @id @default(uuid())
  botId       String     @map("bot_id")
  host        String
  containerId String?    @map("container_id")
  status      HostStatus @default(DOWN)
  cpuLimit    String?    @map("cpu_limit")
  memLimit    String?    @map("mem_limit")
  startedAt   DateTime?  @map("started_at")
  stoppedAt   DateTime?  @map("stopped_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  bot         Bot        @relation(fields: [botId], references: [id], onDelete: Cascade, map: "host_bot_fkey")

  @@index([botId], map: "hosts_bot_id_fkey")
  @@map("hosts")
}

model JobLog {
  id        String    @id @default(uuid())
  botId     String?   @map("bot_id")
  jobId     String    @map("job_id")
  jobType   String    @map("job_type")
  status    JobStatus
  message   String?   @db.Text
  metadata  String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  bot       Bot?      @relation(fields: [botId], references: [id], map: "job_log_bot_fkey")

  @@index([botId], map: "job_logs_bot_id_fkey")
  @@map("job_logs")
}

model BotLog {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id")
  level     LogLevel @default(INFO)
  message   String   @db.Text
  source    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@map("bot_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  botId     String?  @map("bot_id")
  action    String
  resource  String?
  metadata  String?  @db.Text
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  bot       Bot?     @relation(fields: [botId], references: [id], map: "audit_log_bot_fkey")
  user      User?    @relation(fields: [userId], references: [id], map: "audit_log_user_fkey")

  @@index([botId], map: "audit_logs_bot_id_fkey")
  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}

model BotMetrics {
  id                String   @id @default(uuid())
  botId             String   @map("bot_id")
  date              DateTime @map("date") @db.Date
  commandsUsed      Int      @default(0) @map("commands_used")
  messagesProcessed Int      @default(0) @map("messages_processed")
  guildsCount       Int      @default(0) @map("guilds_count")
  usersCount        Int      @default(0) @map("users_count")
  uptimeSeconds     Int      @default(0) @map("uptime_seconds")
  avgResponseTime   Int      @default(0) @map("avg_response_time_ms")
  errorsCount       Int      @default(0) @map("errors_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  bot               Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, date])
  @@map("bot_metrics")
}

model SecurityKey {
  id        String   @id @default(uuid())
  purpose   String   @unique
  keyMeta   String?  @map("key_meta") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("security_keys")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  SUCCESS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum BotStatus {
  OFFLINE
  STARTING
  ONLINE
  ERROR
  STOPPING
  RESTARTING
}

enum HostStatus {
  UP
  DOWN
  STARTING
  STOPPING
  ERROR
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CreditType {
  PURCHASE
  BONUS
  SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

model BotCommand {
  id          String    @id @default(uuid())
  botId       String    @map("bot_id")
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  action      String
  data        Json?
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([botId, status])
  @@map("bot_commands")
}

model BotCollaborator {
  id           String             @id @default(uuid())
  botId        String             @map("bot_id")
  userId       String             @map("user_id")
  invitedBy    String             @map("invited_by")
  role         CollaboratorRole   @default(VIEWER)
  permissions  String?            @db.Text // JSON des permissions granulaires
  status       CollaboratorStatus @default(PENDING)
  invitedAt    DateTime           @default(now()) @map("invited_at")
  acceptedAt   DateTime?          @map("accepted_at")
  lastAccessAt DateTime?          @map("last_access_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  bot          Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([botId, userId])
  @@index([userId])
  @@index([botId, status])
  @@map("bot_collaborators")
}

enum CollaboratorRole {
  VIEWER // Voir seulement
  MODERATOR // Gérer modération, tickets, logs
  DEVELOPER // Gérer commandes, config avancée
  ADMIN // Tout sauf supprimer le bot
}

enum CollaboratorStatus {
  PENDING // Invitation envoyée
  ACTIVE // Acceptée et active
  SUSPENDED // Temporairement suspendu
  REVOKED // Accès révoqué
}

// Enums pour le système de tickets
enum ContainerType {
  CHANNEL
  THREAD
  HYBRID
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssignmentModel {
  AUTO_ASSIGN
  COLLABORATIVE
  SOFT_CLAIM
  STRICT_CLAIM
  NO_ASSIGNMENT
}

enum TicketState {
  OPEN
  IN_PROGRESS
  CLOSED
  RESOLVED
  ARCHIVED
}

model Ticket {
  id                 String              @id @default(uuid())
  guildId            String              @map("guild_id")
  ticketNumber       Int                 @map("ticket_number")
  channelId          String?             @map("channel_id")
  threadId           String?             @map("thread_id")
  creatorId          String              @map("creator_id")
  assignedStaffId    String?             @map("assigned_staff_id")
  type               String
  category           String?
  priority           String              @default("medium")
  state              String              @default("open")
  activityState      String              @default("active") @map("activity_state")
  containerType      String              @default("channel") @map("container_type")
  lastActivity       DateTime            @default(now()) @map("last_activity")
  feedbackRating     Int?                @map("feedback_rating")
  aiEnabled          Boolean             @default(true) @map("ai_enabled")
  aiRecruitmentState String?             @map("ai_recruitment_state") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  closedAt           DateTime?           @map("closed_at")
  deletedAt          DateTime?           @map("deleted_at")
  messages           TicketMessage[]
  participants       TicketParticipant[]
  logs               TicketLog[]

  @@index([guildId])
  @@index([creatorId])
  @@index([state])
  @@map("tickets")
}

model TicketMessage {
  id            String   @id @default(uuid())
  ticketId      String   @map("ticket_id")
  userId        String   @map("user_id")
  authorId      String   @map("author_id")
  content       String   @db.Text
  attachments   Json?
  isStaff       Boolean  @default(false) @map("is_staff")
  messageNumber Int      @default(1) @map("message_number")
  createdAt     DateTime @default(now()) @map("created_at")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketConfig {
  id                   String          @id @default(uuid())
  guildId              String          @unique @map("guild_id")
  botId                String          @map("bot_id")
  enabled              Boolean         @default(true)
  containerType        ContainerType   @default(CHANNEL) @map("container_type")
  categoryId           String?         @map("category_id")
  supportCategoryId    String?         @map("support_category_id")
  staffRoleId          String?         @map("staff_role_id")
  staffRoles           Json?           @map("staff_roles")
  transcriptChannelId  String?         @map("transcript_channel_id")
  logChannelId         String?         @map("log_channel_id")
  namingFormat         String?         @map("naming_format")
  namingPattern        String?         @map("naming_pattern")
  maxTickets           Int             @default(3) @map("max_tickets")
  maxTicketsPerUser    Int             @default(3) @map("max_tickets_per_user")
  cooldownMinutes      Int             @default(5) @map("cooldown_minutes")
  warningHours         Int             @default(24) @map("warning_hours")
  autoCloseHours       Int             @default(48) @map("auto_close_hours")
  assignmentModel      AssignmentModel @default(COLLABORATIVE) @map("assignment_model")
  allowedFileTypes     Json?           @map("allowed_file_types")
  autoSaveTranscripts  Boolean         @default(false) @map("auto_save_transcripts")
  sendTranscriptToUser Boolean         @default(false) @map("send_transcript_to_user")
  includeAttachments   Boolean         @default(true) @map("include_attachments")
  categories           String?         @db.Text
  panels               String?         @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([botId])
  @@index([guildId])
  @@map("ticket_configs")
}

model TicketParticipant {
  id        String    @id @default(uuid())
  ticketId  String    @map("ticket_id")
  userId    String    @map("user_id")
  role      String    @default("OBSERVER")
  addedAt   DateTime  @default(now()) @map("added_at")
  removedAt DateTime? @map("removed_at")
  leftAt    DateTime? @map("left_at")
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId], map: "ticketId_userId")
  @@index([ticketId])
  @@map("ticket_participants")
}

model TicketLog {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  action      String
  performedBy String   @map("performed_by")
  details     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_logs")
}

// Modèles supplémentaires pour le système de tickets avancé
model TicketCategory {
  id             String   @id @default(uuid())
  guildId        String   @map("guild_id")
  botId          String   @map("bot_id")
  name           String
  emoji          String?
  active         Boolean  @default(true)
  aiDirection    String?  @map("ai_direction") @db.Text
  aiSystemPrompt String?  @map("ai_system_prompt") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([guildId])
  @@index([botId])
  @@map("ticket_categories")
}

model TicketPanel {
  id        String   @id @default(uuid())
  guildId   String   @map("guild_id")
  botId     String   @map("bot_id")
  channelId String   @map("channel_id")
  messageId String?  @map("message_id")
  type      String
  active    Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([guildId])
  @@index([botId])
  @@index([channelId])
  @@map("ticket_panels")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  metadata  String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ==================== MODULE SYSTEM ====================

model Module {
  id              String         @id @default(uuid())
  slug            String         @unique
  name            String
  description     String         @db.Text
  longDescription String?        @map("long_description") @db.Text
  category        ModuleCategory
  price           Int            @default(0) // 0 = gratuit
  icon            String?
  banner          String?
  version         String         @default("1.0.0")
  author          String         @default("FiveBot")
  tags            String?        @db.Text // JSON array
  features        String?        @db.Text // JSON array
  screenshots     String?        @db.Text // JSON array of URLs
  dependencies    String?        @db.Text // JSON array of module slugs
  configSchema    String?        @map("config_schema") @db.Text // JSON schema for config UI
  isCore          Boolean        @default(false) @map("is_core") // Framework modules
  isActive        Boolean        @default(true) @map("is_active") // Admin can disable
  downloads       Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  userModules     UserModule[]
  botModules      BotModule[]

  @@index([category])
  @@index([isCore])
  @@index([isActive])
  @@map("modules")
}

model UserModule {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  moduleId      String   @map("module_id")
  purchasedAt   DateTime @default(now()) @map("purchased_at")
  paymentAmount Int      @default(0) @map("payment_amount")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("user_modules")
}

model BotModule {
  id          String   @id @default(uuid())
  botId       String   @map("bot_id")
  moduleId    String   @map("module_id")
  enabled     Boolean  @default(true)
  config      String?  @db.Text // JSON config specific to this module
  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([botId, moduleId])
  @@index([botId])
  @@index([moduleId])
  @@index([botId, enabled])
  @@map("bot_modules")
}

enum ModuleCategory {
  FRAMEWORK // Core/essential
  MODERATION // Ban, kick, mute, etc.
  WELCOME // Welcome/goodbye
  AUTOMATION // Auto-role, auto-mod
  UTILITY // Info commands, embeds
  TICKETS // Support system
  LOGGING // Event logs
  FUN // Games, memes
  MUSIC // Music player
  ECONOMY // Virtual currency
  LEVELING // XP/levels
  CUSTOM // Custom commands
  AI // Artificial Intelligence
}

// ==================== TRANSACTIONS ====================

model Transaction {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  type        TransactionType
  amount      Int // Credits amount
  description String
  metadata    String?           @db.Text // JSON: module info, admin notes, etc.
  status      TransactionStatus @default(COMPLETED)
  createdAt   DateTime          @default(now()) @map("created_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

enum TransactionType {
  MODULE_PURCHASE
  CREDIT_PURCHASE
  ADMIN_GRANT
  ADMIN_DEDUCT
  REFUND
  BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== AI SYSTEM ====================

model AIConfig {
  id                       String           @id @default(uuid())
  guildId                  String           @unique @map("guild_id")
  botId                    String           @map("bot_id")
  enabled                  Boolean          @default(false)
  apiKey                   String?          @map("api_key") @db.Text
  model                    String           @default("gpt-5-nano")
  responseMode             String           @default("mention") @map("response_mode")
  personality              String           @default("friendly")
  customPersonality        String?          @map("custom_personality") @db.Text
  systemPrompt             String?          @map("system_prompt") @db.Text
  dmSystemPrompt           String?          @map("dm_system_prompt") @db.Text
  channelPrompts           String?          @map("channel_prompts") @db.Text
  threadPrompts            String?          @map("thread_prompts") @db.Text
  enableVision             Boolean          @default(false) @map("enable_vision")
  includeUserContext       Boolean          @default(true) @map("include_user_context")
  includeChannelContext    Boolean          @default(true) @map("include_channel_context")
  temperature              Float            @default(0.7)
  maxTokens                Int              @default(500) @map("max_tokens")
  enabledChannels          String?          @map("enabled_channels") @db.Text
  disabledChannels         String?          @map("disabled_channels") @db.Text
  enableInTickets          Boolean          @default(true) @map("enable_in_tickets")
  enableInThreads          Boolean          @default(false) @map("enable_in_threads")
  triggerKeywords          String?          @map("trigger_keywords") @db.Text
  ignorePrefixes           String?          @map("ignore_prefixes") @db.Text
  requireMention           Boolean          @default(false) @map("require_mention")
  typingIndicator          Boolean          @default(true) @map("typing_indicator")
  responseDelay            Int              @default(0) @map("response_delay")
  maxResponseLength        Int              @default(2000) @map("max_response_length")
  useEmbeds                Boolean          @default(true) @map("use_embeds")
  embedColor               String?          @map("embed_color")
  showThinking             Boolean          @default(false) @map("show_thinking")
  conversationHistory      Boolean          @default(true) @map("conversation_history")
  contextWindow            Int              @default(10) @map("context_window")
  useRAG                   Boolean          @default(false) @map("use_rag")
  rateLimitPerUser         Int              @default(10) @map("rate_limit_per_user")
  rateLimitPerChannel      Int              @default(50) @map("rate_limit_per_channel")
  blockNSFW                Boolean          @default(true) @map("block_nsfw")
  contentFilter            Boolean          @default(true) @map("content_filter")
  monthlyTokenLimit        Int?             @map("monthly_token_limit")
  alertOnLimit             Boolean          @default(true) @map("alert_on_limit")
  alertChannelId           String?          @map("alert_channel_id")
  functionCalling          Boolean          @default(false) @map("function_calling")
  allowedFunctions         String?          @map("allowed_functions") @db.Text
  logConversations         Boolean          @default(true) @map("log_conversations")
  // Previously frontend-only fields - now persisted
  respondToEveryone        Boolean          @default(false) @map("respond_to_everyone")
  everyoneContextDepth     Int              @default(10) @map("everyone_context_depth")
  followReplyChains        Boolean          @default(true) @map("follow_reply_chains")
  detectContextType        Boolean          @default(true) @map("detect_context_type")
  replyToMentions          Boolean          @default(true) @map("reply_to_mentions")
  replyToReplies           Boolean          @default(true) @map("reply_to_replies")
  replyToKeywords          Boolean          @default(false) @map("reply_to_keywords")
  conversationHistoryLimit Int              @default(10) @map("conversation_history_limit")
  rateLimitWindow          Int              @default(60) @map("rate_limit_window")
  useEmbedding             Boolean          @default(false) @map("use_embedding")
  maxDocumentChunks        Int              @default(5) @map("max_document_chunks")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  usage                    AIUsage[]
  conversations            AIConversation[]
