}

model AIMemory {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  userId    String  @map("user_id")
  guildId   String? @map("guild_id")

  // Memory Content
  memoryType MemoryType @map("memory_type")
  content    String     @db.Text
  context    String?    @db.Text // Context when memory was formed
  importance Int        @default(50) // 0-100: how important is this memory

  // Memory Metadata
  emotionalTone String? @map("emotional_tone") // positive, negative, neutral, funny
  tags          String? @db.Text // JSON array: searchable tags
  references    String? @db.Text // JSON: related memory IDs or topics

