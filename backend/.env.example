# Backend Environment Variables for VPS Deployment

# Server Configuration
NODE_ENV=production
PORT=3001

# Database (PostgreSQL on VPS)
DATABASE_URL="postgresql://fivebot_user:CHANGE_THIS_PASSWORD@localhost:5432/fivebot"

# Redis (Local on VPS or Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=generate-strong-random-secret-here
JWT_EXPIRES_IN=7d

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://votredomaine.com/api/auth/callback/discord
DISCORD_BOT_TOKEN=your-discord-bot-token

# Frontend URL
FRONTEND_URL=https://votredomaine.com

# Bot Manager Configuration
BOT_STORAGE_PATH=/var/fivebot/bots
DOCKER_SOCKET=/var/run/docker.sock

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/fivebot/uploads
