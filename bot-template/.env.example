# FiveBot Bot Template - Environment Variables
# These are injected automatically when a bot is spawned
# This file is for reference only

# ===========================================
# BOT CONFIGURATION (injected by backend)
# ===========================================
BOT_ID=uuid-of-the-bot
BOT_TOKEN=discord-bot-token

# ===========================================
# BACKEND CONNECTION
# ===========================================
BACKEND_URL=http://localhost:8000

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# BOT CONFIG (JSON string, injected by backend)
# ===========================================
CONFIG={"prefix":"!","welcomeEnabled":false}

# ===========================================
# RUNTIME
# ===========================================
NODE_ENV=production
