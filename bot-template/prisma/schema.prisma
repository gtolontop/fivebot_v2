// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  discordId  String   @unique @map("discord_id")
  username   String
  email      String?
  avatar     String?
  role       UserRole @default(USER)
  credits    Int      @default(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  bots           Bot[]
  creditsHistory CreditsHistory[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Bot {
  id              String    @id @default(uuid())
  ownerId         String    @map("owner_id")
  name            String
  tokenEncrypted  String    @map("token_encrypted") @db.Text
  clientId        String?   @map("client_id")
  prefix          String    @default("!")
  isActive        Boolean   @default(false) @map("is_active")
  containerId     String?   @map("container_id")
  instanceId      String?   @map("instance_id")
  status          BotStatus @default(OFFLINE)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  config      BotConfig?
  hosts       Host[]
  jobLogs     JobLog[]
  auditLogs   AuditLog[]

  @@map("bots")
}

model BotConfig {
  id                  String  @id @default(uuid())
  botId               String  @unique @map("bot_id")
  welcomeEnabled      Boolean @default(false) @map("welcome_enabled")
  welcomeChannelId    String? @map("welcome_channel_id")
  welcomeEmbedJson    Json?   @map("welcome_embed_json")
  welcomeLogoUrl      String? @map("welcome_logo_url")
  moderationEnabled   Boolean @default(false) @map("moderation_enabled")
  autoRoleEnabled     Boolean @default(false) @map("auto_role_enabled")
  autoRoleId          String? @map("auto_role_id")
  loggingChannelId    String? @map("logging_channel_id")
  customCommands      Json?   @map("custom_commands")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_configs")
}

model CreditsHistory {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  amount    Int
  reason    String
  type      CreditType
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credits_history")
}

model Host {
  id          String     @id @default(uuid())
  botId       String     @map("bot_id")
  host        String
  containerId String?    @map("container_id")
  status      HostStatus @default(DOWN)
  cpuLimit    String?    @map("cpu_limit")
  memLimit    String?    @map("mem_limit")
  startedAt   DateTime?  @map("started_at")
  stoppedAt   DateTime?  @map("stopped_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("hosts")
}

model JobLog {
  id        String    @id @default(uuid())
  botId     String?   @map("bot_id")
  jobId     String    @map("job_id")
  jobType   String    @map("job_type")
  status    JobStatus
  message   String?   @db.Text
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  bot Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@map("job_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  botId     String?  @map("bot_id")
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  bot  Bot?  @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SecurityKey {
  id        String   @id @default(uuid())
  purpose   String   @unique
  keyMeta   Json?    @map("key_meta")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("security_keys")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum BotStatus {
  OFFLINE
  STARTING
  ONLINE
  ERROR
  STOPPING
}

enum HostStatus {
  UP
  DOWN
  STARTING
  STOPPING
  ERROR
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CreditType {
  PURCHASE
  BONUS
  SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

// Ticket System Models
model Ticket {
  id               String           @id @default(uuid())
  guildId          String           @map("guild_id")
  ticketNumber     Int              @map("ticket_number")
  channelId        String           @map("channel_id")
  threadId         String?          @map("thread_id")
  creatorId        String           @map("creator_id")
  assignedStaffId  String?          @map("assigned_staff_id")
  type             String           @default("support")
  category         String?
  priority         TicketPriority   @default(NORMAL)
  state            TicketState      @default(NEW)
  activityState    ActivityState    @default(GRAY)
  containerType    ContainerType    @default(THREAD)
  lastMessageFrom  String?          @map("last_message_from")
  lastActivity     DateTime         @default(now()) @map("last_activity")
  warningsentAt    DateTime?        @map("warning_sent_at")
  closedAt         DateTime?        @map("closed_at")
  deletedAt        DateTime?        @map("deleted_at")
  deletedBy        String?          @map("deleted_by")
  deletionReason   String?          @map("deletion_reason")
  permanentDeleteAt DateTime?       @map("permanent_delete_at")
  backupData       Json?            @map("backup_data")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  messages         TicketMessage[]
  participants     TicketParticipant[]
  logs             TicketLog[]
  timers           TicketTimer[]

  // Indexes
  @@unique([guildId, ticketNumber])
  @@index([guildId, state])
  @@index([assignedStaffId, state])
  @@index([lastActivity, warningsentAt])
  @@index([deletedAt, permanentDeleteAt])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  messageId   String   @map("message_id")
  authorId    String   @map("author_id")
  content     String   @db.Text
  isStaff     Boolean  @default(false) @map("is_staff")
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketParticipant {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  role      ParticipantRole
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  // Relations
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@map("ticket_participants")
}

model TicketLog {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  action     String
  performedBy String  @map("performed_by")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_logs")
}

model TicketTimer {
  id          String     @id @default(uuid())
  ticketId    String     @map("ticket_id")
  type        TimerType
  threshold   Int
  startTime   DateTime   @default(now()) @map("start_time")
  lastReset   DateTime   @default(now()) @map("last_reset")
  ticketType  String     @map("ticket_type")
  active      Boolean    @default(true)

  // Relations
  ticket      Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, type])
  @@map("ticket_timers")
}

model TicketConfig {
  id                    String              @id @default(uuid())
  guildId               String              @unique @map("guild_id")
  enabled               Boolean             @default(true)
  assignmentModel       AssignmentModel     @default(COLLABORATIVE)
  containerType         ContainerType       @default(THREAD)
  namingPattern         String              @default("ticket-{counter}") @map("naming_pattern")
  startingNumber        Int                 @default(1) @map("starting_number")
  staffRoles            Json                @default("[]") @map("staff_roles")
  supportCategoryId     String?             @map("support_category_id")
  logChannelId          String?             @map("log_channel_id")
  autoCloseHours        Int                 @default(48) @map("auto_close_hours")
  warningHours          Int                 @default(24) @map("warning_hours")
  maxTicketsPerUser     Int                 @default(3) @map("max_tickets_per_user")
  cooldownMinutes       Int                 @default(5) @map("cooldown_minutes")
  allowedFileTypes      Json                @default("[]") @map("allowed_file_types")
  maxFileSize           Int                 @default(8388608) @map("max_file_size")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  // Relations
  panels                TicketPanel[]
  categories            TicketCategory[]

  @@map("ticket_configs")
}

model TicketPanel {
  id           String         @id @default(uuid())
  guildId      String         @map("guild_id")
  configId     String         @map("config_id")
  channelId    String         @map("channel_id")
  messageId    String?        @map("message_id")
  type         PanelType      @default(BUTTON)
  embedData    Json           @map("embed_data")
  components   Json
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  config       TicketConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@map("ticket_panels")
}

model TicketCategory {
  id            String        @id @default(uuid())
  guildId       String        @map("guild_id")
  configId      String        @map("config_id")
  name          String
  emoji         String?
  description   String?
  staffRoleId   String?       @map("staff_role_id")
  channelId     String?       @map("channel_id")
  order         Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  config        TicketConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, name])
  @@map("ticket_categories")
}

// Enums for Ticket System
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketState {
  NEW
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum ActivityState {
  GRAY    // New, no activity
  ORANGE  // Waiting for staff
  GREEN   // Waiting for user
  RED     // Idle warning
}

enum ContainerType {
  THREAD
  CHANNEL
  HYBRID
}

enum AssignmentModel {
  COLLABORATIVE  // All staff can reply
  SOFT_CLAIM     // Optional ownership
  STRICT_CLAIM   // Exclusive ownership
  AUTO_ASSIGN    // System assigns
  NO_ASSIGNMENT  // Pure activity tracking
}

enum ParticipantRole {
  CREATOR
  STAFF
  MEMBER
  OBSERVER
}

enum TimerType {
  IDLE
  WARNING
  AUTO_CLOSE
}

enum PanelType {
  BUTTON
  DROPDOWN
  HYBRID
}

model BotCommand {
  id          String    @id @default(uuid())
  botId       String    @map("bot_id")
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  action      String
  data        Json?
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  
  @@map("bot_commands")
  @@index([botId, status])
}